[Unit]
Description=OpenDIHM Firmware API
After=network.target

[Service]
Type=simple
User=opendihm
Group=opendihm
WorkingDirectory=/tmp
Environment=PYTHONPATH=/opt/opendihm/src
ExecStart=/opt/opendihm/.venv/bin/python -m uvicorn opendihm_firmware.app:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
